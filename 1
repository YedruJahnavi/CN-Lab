#include <stdio.h> 
int main() { 
    char *str = "Hello World"; 
    int i = 0; 
    printf("Original String: %s\n", str); 
    printf("Result after XOR with 0: "); 
    while (str[i] != '\0') { 
        printf("%c", str[i] ^ 0); 
        i++; 
    } 
    return 0; 
}


output
Original String: Hello World
Result after XOR with 0: Hello World
